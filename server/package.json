    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.2",
    "pg": "^8.23.0",
    "socket.io": "^4.8.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/jszip": "^3.4.0",
    "@types/node": "^22.13.5",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^10.0.0",
    "socket.io-client": "^4.8.1",
